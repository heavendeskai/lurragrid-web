---
---

<div class="hero-svg-container w-full max-w-2xl mx-auto">
  <svg
    viewBox="0 0 600 800"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto svg-draw"
    role="img"
    aria-label="LURRACORE underground cross-section: a pump train on one shaft lifts water to the upper reservoir using curtailed energy while, on a separate independent shaft, a turbine train generates continuously for the data center"
  >
    <defs>
      <pattern id="grid" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0044AA" stroke-width="0.3" opacity="0.15"/>
      </pattern>
      <linearGradient id="shaftGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#0044AA" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#0044AA" stop-opacity="0.1"/>
      </linearGradient>
      <linearGradient id="waterTop" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#0055CC" stop-opacity="0.9"/>
        <stop offset="100%" stop-color="#003388" stop-opacity="0.5"/>
      </linearGradient>
      <linearGradient id="waterBot" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#0044AA" stop-opacity="0.5"/>
        <stop offset="100%" stop-color="#002266" stop-opacity="0.25"/>
      </linearGradient>
      <!-- Pump return shaft: water travels UP -->
      <clipPath id="pumpShaftClip">
        <rect x="160" y="190" width="30" height="300"/>
      </clipPath>
      <!-- Generation shaft: water travels DOWN -->
      <clipPath id="genShaftClip">
        <rect x="400" y="190" width="30" height="300"/>
      </clipPath>
      <clipPath id="suctionClip">
        <rect x="168" y="568" width="14" height="46"/>
      </clipPath>
      <clipPath id="draftClip">
        <rect x="408" y="568" width="14" height="46"/>
      </clipPath>
      <filter id="boltGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <rect width="600" height="800" fill="url(#grid)" opacity="0.5"/>

    <!-- ═══ SURFACE ═══ -->
    <line x1="0" y1="60" x2="600" y2="60" stroke="#F5F7FA" stroke-width="1.5" class="delay-1"/>
    <text x="250" y="52" fill="#A0A8B5" font-size="9" font-family="Inter,sans-serif" letter-spacing="2"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 0.3s ease forwards;opacity:0">SURFACE</text>

    <!-- ═══ CURTAILED ENERGY INPUT — drives the pump train only ═══ -->
    <circle cx="40" cy="40" r="17" fill="#0A0E18" stroke="#0055CC" stroke-width="1.5" class="delay-1"/>
    <path d="M 44 28 L 35 40 L 41 40 L 33 52 L 46 38 L 40 38 Z"
      fill="#0055CC" filter="url(#boltGlow)"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0s 2.5s ease forwards,pumpPulse 1.6s 2.5s ease-in-out infinite;opacity:0"/>
    <text x="6" y="10" fill="#4D9FFF" font-size="7" font-family="Inter,sans-serif" letter-spacing="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.3s ease forwards;opacity:0">CURTAILED</text>
    <text x="6" y="19" fill="#4D9FFF" font-size="7" font-family="Inter,sans-serif" letter-spacing="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.4s ease forwards;opacity:0">ENERGY IN</text>

    <!-- ═══ BTM OUTPUT — the turbine serves the load at all times ═══ -->
    <circle cx="556" cy="40" r="17" fill="#0A0E18" stroke="#FF6600" stroke-width="1.5" class="delay-6"/>
    <path d="M 560 28 L 551 40 L 557 40 L 549 52 L 562 38 L 556 38 Z"
      fill="#FF6600" filter="url(#boltGlow)"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0s 2.5s ease forwards,boltPulse 1.6s 2.8s ease-in-out infinite;opacity:0"/>
    <text x="596" y="10" text-anchor="end" fill="#FF6600" font-size="7" font-family="Inter,sans-serif" letter-spacing="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.3s ease forwards;opacity:0">BTM OUTPUT</text>
    <text x="596" y="19" text-anchor="end" fill="#A0A8B5" font-size="6.5" font-family="Inter,sans-serif" letter-spacing="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.4s ease forwards;opacity:0">DATA CENTER ↑</text>

    <!-- Headframe LEFT — pump return shaft -->
    <line x1="175" y1="10" x2="175" y2="60" stroke="#0055CC" stroke-width="1.5" class="delay-1"/>
    <line x1="150" y1="60" x2="200" y2="60" stroke="#0055CC" stroke-width="2" class="delay-1"/>
    <line x1="160" y1="10" x2="175" y2="30" stroke="#0055CC" stroke-width="1" class="delay-1"/>
    <line x1="190" y1="10" x2="175" y2="30" stroke="#0055CC" stroke-width="1" class="delay-1"/>
    <text x="100" y="8" fill="#A0A8B5" font-size="7.5" font-family="Inter,sans-serif" letter-spacing="1.2"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 0.4s ease forwards;opacity:0">PUMP RETURN SHAFT</text>

    <!-- Headframe RIGHT — generation shaft -->
    <line x1="415" y1="10" x2="415" y2="60" stroke="#0055CC" stroke-width="1.5" class="delay-2"/>
    <line x1="390" y1="60" x2="440" y2="60" stroke="#0055CC" stroke-width="2" class="delay-2"/>
    <line x1="400" y1="10" x2="415" y2="30" stroke="#0055CC" stroke-width="1" class="delay-2"/>
    <line x1="430" y1="10" x2="415" y2="30" stroke="#0055CC" stroke-width="1" class="delay-2"/>
    <text x="350" y="8" fill="#A0A8B5" font-size="7.5" font-family="Inter,sans-serif" letter-spacing="1.2"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 0.4s ease forwards;opacity:0">GENERATION SHAFT</text>

    <!-- ═══ UPPER RESERVOIR ═══ -->
    <rect x="80" y="62" width="340" height="128" rx="3" fill="#0044AA" fill-opacity="0.10" stroke="#0044AA" stroke-width="1.5" class="delay-2"/>
    <rect x="82" y="80" width="336" height="108" rx="2" fill="url(#waterTop)" fill-opacity="0.65" class="delay-3"/>
    <line x1="82" y1="80" x2="418" y2="80" stroke="#0055CC" stroke-width="1.2" stroke-dasharray="5,3" class="water-surface"/>
    <text x="215" y="77" fill="#A0A8B5" font-size="8" font-family="Inter,sans-serif" letter-spacing="2"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 1.2s ease forwards;opacity:0">UPPER RESERVOIR</text>

    <!-- ═══ LEFT SHAFT — pump return, water rises ═══ -->
    <rect x="160" y="190" width="30" height="300" fill="url(#shaftGrad)" stroke="#0044AA" stroke-width="1" class="delay-3"/>
    <path d="M 143 350 L 143 320 M 138 326 L 143 320 L 148 326" fill="none" stroke="#0055CC" stroke-width="1" class="delay-4"/>

    <!-- ═══ RIGHT SHAFT — generation, water falls ═══ -->
    <rect x="400" y="190" width="30" height="300" fill="url(#shaftGrad)" stroke="#0044AA" stroke-width="1" class="delay-3"/>
    <path d="M 447 320 L 447 350 M 442 344 L 447 350 L 452 344" fill="none" stroke="#0055CC" stroke-width="1" class="delay-4"/>

    <!-- ═══ DEPTH SPINE — centred between the two independent shafts ═══ -->
    <line x1="295" y1="190" x2="295" y2="730" stroke="#0044AA" stroke-width="0.5" stroke-opacity="0.6" class="delay-3"/>
    <line x1="287" y1="290" x2="303" y2="290" stroke="#0044AA" stroke-width="0.5" class="delay-3"/>
    <text x="310" y="294" fill="#A0A8B5" font-size="8" font-family="Inter,sans-serif" letter-spacing="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 1.4s ease forwards;opacity:0">1,500 ft</text>
    <line x1="287" y1="390" x2="303" y2="390" stroke="#0044AA" stroke-width="0.5" class="delay-4"/>
    <text x="310" y="394" fill="#A0A8B5" font-size="8" font-family="Inter,sans-serif" letter-spacing="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 1.6s ease forwards;opacity:0">2,500 ft</text>
    <line x1="287" y1="725" x2="303" y2="725" stroke="#0044AA" stroke-width="0.5" class="delay-6"/>
    <text x="310" y="729" fill="#A0A8B5" font-size="8" font-family="Inter,sans-serif" letter-spacing="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.2s ease forwards;opacity:0">3,500 ft</text>

    <!-- Rising water in the pump return shaft -->
    <g clip-path="url(#pumpShaftClip)" style="opacity:0;animation:fadeIn 0s 3s ease forwards">
      <circle cx="172" cy="470" r="3"   fill="#0055CC" fill-opacity="0.8" class="drip-up dr-1"/>
      <circle cx="178" cy="430" r="2.5" fill="#0066DD" fill-opacity="0.7" class="drip-up dr-2"/>
      <circle cx="170" cy="390" r="3"   fill="#0055CC" fill-opacity="0.8" class="drip-up dr-3"/>
      <circle cx="180" cy="350" r="2"   fill="#0066DD" fill-opacity="0.6" class="drip-up dr-4"/>
      <circle cx="174" cy="310" r="3"   fill="#0055CC" fill-opacity="0.8" class="drip-up dr-5"/>
      <rect x="171" y="440" width="2" height="12" fill="#0055CC" fill-opacity="0.4" class="drip-up dr-2"/>
      <rect x="177" y="400" width="2" height="10" fill="#0055CC" fill-opacity="0.4" class="drip-up dr-3"/>
      <rect x="173" y="360" width="2" height="14" fill="#0055CC" fill-opacity="0.4" class="drip-up dr-4"/>
      <rect x="179" y="320" width="2" height="12" fill="#0055CC" fill-opacity="0.4" class="drip-up dr-5"/>
    </g>

    <!-- Falling water in the generation shaft -->
    <g clip-path="url(#genShaftClip)" style="opacity:0;animation:fadeIn 0s 3s ease forwards">
      <circle cx="412" cy="220" r="3"   fill="#0055CC" fill-opacity="0.8" class="drop drop-1"/>
      <circle cx="418" cy="270" r="2.5" fill="#0066DD" fill-opacity="0.7" class="drop drop-2"/>
      <circle cx="410" cy="330" r="3"   fill="#0055CC" fill-opacity="0.8" class="drop drop-3"/>
      <circle cx="420" cy="380" r="2"   fill="#0066DD" fill-opacity="0.6" class="drop drop-4"/>
      <circle cx="414" cy="430" r="3"   fill="#0055CC" fill-opacity="0.8" class="drop drop-5"/>
      <rect x="411" y="240" width="2" height="12" fill="#0055CC" fill-opacity="0.4" class="drop drop-2"/>
      <rect x="417" y="300" width="2" height="10" fill="#0055CC" fill-opacity="0.4" class="drop drop-3"/>
      <rect x="413" y="360" width="2" height="14" fill="#0055CC" fill-opacity="0.4" class="drop drop-4"/>
      <rect x="419" y="410" width="2" height="12" fill="#0055CC" fill-opacity="0.4" class="drop drop-5"/>
    </g>

    <!-- ═══ PUMP TRAIN — independent shaft, driven by curtailed energy ═══ -->
    <rect x="100" y="490" width="150" height="78" rx="6" fill="#0044AA" fill-opacity="0.18" stroke="#0055CC" stroke-width="1.5" class="delay-5"/>
    <circle cx="175" cy="529" r="22" fill="#000814" fill-opacity="0.6" stroke="#0044AA" stroke-width="1" class="delay-5"/>
    <!-- Curved impeller vanes — a pump, not a turbine -->
    <path d="M 175 529 Q 170 510 156 516" fill="none" stroke="#0055CC" stroke-width="1" class="delay-5"/>
    <path d="M 175 529 Q 194 524 188 510" fill="none" stroke="#0055CC" stroke-width="1" class="delay-5"/>
    <path d="M 175 529 Q 180 548 194 542" fill="none" stroke="#0055CC" stroke-width="1" class="delay-5"/>
    <path d="M 175 529 Q 156 534 162 548" fill="none" stroke="#0055CC" stroke-width="1" class="delay-5"/>
    <circle cx="175" cy="529" r="27" fill="none" stroke="#0055CC" stroke-width="1"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0s 3.2s ease forwards,pumpPulse 1.6s 3.2s ease-in-out infinite;opacity:0"/>
    <text x="104" y="484" fill="#A0A8B5" font-size="8" font-family="Inter,sans-serif" letter-spacing="1.5"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.0s ease forwards;opacity:0">PUMP TRAIN</text>
    <text x="104" y="582" fill="#4D9FFF" font-size="6.5" font-family="Inter,sans-serif" letter-spacing="0.8"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.6s ease forwards;opacity:0">DRIVEN BY CURTAILED ENERGY</text>

    <!-- ═══ TURBINE TRAIN — independent shaft, never stops ═══ -->
    <rect x="340" y="490" width="150" height="78" rx="6" fill="#0044AA" fill-opacity="0.18" stroke="#0055CC" stroke-width="1.5" class="delay-5"/>
    <circle cx="415" cy="529" r="22" fill="#000814" fill-opacity="0.6" stroke="#0044AA" stroke-width="1" class="delay-5"/>
    <line x1="415" y1="510" x2="415" y2="548" stroke="#0044AA" stroke-width="1" class="delay-5"/>
    <line x1="396" y1="529" x2="434" y2="529" stroke="#0044AA" stroke-width="1" class="delay-5"/>
    <line x1="402" y1="516" x2="428" y2="542" stroke="#0044AA" stroke-width="0.7" class="delay-5"/>
    <line x1="402" y1="542" x2="428" y2="516" stroke="#0044AA" stroke-width="0.7" class="delay-5"/>
    <path d="M 419 510 L 409 528 L 417 528 L 409 548 L 421 526 L 413 526 Z"
      fill="#FF6600" filter="url(#boltGlow)" class="bolt-pulse"
      style="opacity:0;animation:fadeIn 0s 3.2s ease forwards,boltPulse 1.6s 3.2s ease-in-out infinite"/>
    <text x="344" y="484" fill="#A0A8B5" font-size="8" font-family="Inter,sans-serif" letter-spacing="1.5"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.0s ease forwards;opacity:0">TURBINE TRAIN</text>
    <text x="344" y="582" fill="#FF6600" font-size="6.5" font-family="Inter,sans-serif" letter-spacing="0.8"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.6s ease forwards;opacity:0">SERVES THE DATA CENTER 24/7</text>

    <!-- ═══ ENERGY ROUTING — input left to the pump, output right from the turbine ═══ -->
    <line x1="40" y1="57" x2="40" y2="529" stroke="#0055CC" stroke-width="1" stroke-dasharray="5,3" stroke-opacity="0.6" class="delay-5"/>
    <line x1="40" y1="529" x2="100" y2="529" stroke="#0055CC" stroke-width="1" stroke-dasharray="5,3" stroke-opacity="0.6" class="delay-5"/>
    <line x1="490" y1="529" x2="556" y2="529" stroke="#FF6600" stroke-width="1" stroke-dasharray="5,3" stroke-opacity="0.6" class="delay-5"/>
    <line x1="556" y1="529" x2="556" y2="57" stroke="#FF6600" stroke-width="1" stroke-dasharray="5,3" stroke-opacity="0.6" class="delay-6"/>

    <!-- ═══ WATER ROUTING at depth ═══ -->
    <!-- Pump suction: lower reservoir up into the pump -->
    <line x1="175" y1="568" x2="175" y2="612" stroke="#0055CC" stroke-width="3" class="delay-5"/>
    <g clip-path="url(#suctionClip)" style="opacity:0;animation:fadeIn 0s 3.5s ease forwards">
      <circle cx="175" cy="605" r="3"   fill="#0055CC" fill-opacity="0.8" class="drip-up dru-1"/>
      <circle cx="175" cy="592" r="2.5" fill="#0066DD" fill-opacity="0.7" class="drip-up dru-2"/>
    </g>
    <!-- Turbine discharge: down into the lower reservoir -->
    <line x1="415" y1="568" x2="415" y2="612" stroke="#0055CC" stroke-width="3" class="delay-5"/>
    <g clip-path="url(#draftClip)" style="opacity:0;animation:fadeIn 0s 3.5s ease forwards">
      <circle cx="415" cy="575" r="3"   fill="#0055CC" fill-opacity="0.8" class="drop drop-penstock-1"/>
      <circle cx="415" cy="590" r="2.5" fill="#0066DD" fill-opacity="0.7" class="drop drop-penstock-2"/>
    </g>

    <!-- ═══ LOWER RESERVOIR ═══ -->
    <rect x="80" y="612" width="340" height="118" rx="3" fill="#0044AA" fill-opacity="0.08" stroke="#0044AA" stroke-width="1.5" class="delay-6"/>
    <rect x="82" y="670" width="336" height="58" rx="2" fill="url(#waterBot)" fill-opacity="0.5" class="delay-6"/>
    <line x1="82" y1="670" x2="418" y2="670" stroke="#0044AA" stroke-width="1" stroke-dasharray="4,3" class="water-surface-slow"/>
    <text x="215" y="752" fill="#A0A8B5" font-size="8" font-family="Inter,sans-serif" letter-spacing="2"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.4s ease forwards;opacity:0">LOWER RESERVOIR</text>

    <!-- ═══ The point of the drawing ═══ -->
    <text x="300" y="784" text-anchor="middle" fill="#FF6600" font-size="8" font-family="Inter,sans-serif" letter-spacing="1.5"
      style="stroke-dasharray:none;stroke-dashoffset:0;animation:fadeIn 0.5s 2.8s ease forwards;opacity:0">PUMPING AND GENERATION RUN CONCURRENTLY — INDEPENDENT SHAFTS</text>
  </svg>
</div>

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Orange bolt pulse — the turbine, always generating */
  @keyframes boltPulse {
    0%, 100% { opacity: 0.4; filter: drop-shadow(0 0 2px #FF6600); }
    50%       { opacity: 1.0; filter: drop-shadow(0 0 8px #FF8800) drop-shadow(0 0 16px #FF6600); }
  }

  /* Blue pulse — the pump train drawing curtailed energy, at the same time */
  @keyframes pumpPulse {
    0%, 100% { opacity: 0.3; filter: drop-shadow(0 0 2px #0055CC); }
    50%       { opacity: 0.9; filter: drop-shadow(0 0 8px #0066EE) drop-shadow(0 0 14px #0055CC); }
  }

  /* Water falling — generation shaft */
  @keyframes dropFall {
    0%   { transform: translateY(0);    opacity: 0.9; }
    80%  { transform: translateY(270px); opacity: 0.6; }
    100% { transform: translateY(300px); opacity: 0; }
  }

  /* Water rising — pump return shaft */
  @keyframes dropRise {
    0%   { transform: translateY(0);      opacity: 0.9; }
    80%  { transform: translateY(-270px); opacity: 0.6; }
    100% { transform: translateY(-300px); opacity: 0; }
  }

  .drop { animation: dropFall 2.4s ease-in infinite; }
  .drop-1 { animation-delay: 3.0s; }
  .drop-2 { animation-delay: 3.5s; }
  .drop-3 { animation-delay: 4.0s; }
  .drop-4 { animation-delay: 4.5s; }
  .drop-5 { animation-delay: 5.0s; }
  .drop-penstock-1 { animation: dropFall 1.2s ease-in infinite; animation-delay: 3.5s; }
  .drop-penstock-2 { animation: dropFall 1.2s ease-in infinite; animation-delay: 3.9s; }

  .drip-up { animation: dropRise 2.4s ease-out infinite; }
  .dr-1 { animation-delay: 3.0s; }
  .dr-2 { animation-delay: 3.5s; }
  .dr-3 { animation-delay: 4.0s; }
  .dr-4 { animation-delay: 4.5s; }
  .dr-5 { animation-delay: 5.0s; }
  .dru-1 { animation: dropRise 1.2s ease-out infinite; animation-delay: 3.5s; }
  .dru-2 { animation: dropRise 1.2s ease-out infinite; animation-delay: 3.9s; }

  /* Water surface shimmer */
  @keyframes shimmer {
    0%   { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -30; }
  }
  .water-surface      { opacity:0; animation: fadeIn 0.5s 1.5s ease forwards, shimmer 2s 2s linear infinite; }
  .water-surface-slow { opacity:0; animation: fadeIn 0.5s 2.5s ease forwards, shimmer 3s 3s linear infinite; }
</style>
